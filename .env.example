# ─────────────────────────────────────────────────────────────────
# MOMENTUM — Environment Configuration
# Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────────────────

# ── LLM (required for automation plan generation) ─────────────────
# Get your key at: https://platform.openai.com/api-keys
MOMENTUM_LLM_API_KEY=sk-...

# LLM provider and model (defaults shown)
MOMENTUM_LLM_PROVIDER=openai
MOMENTUM_LLM_MODEL=gpt-4o-mini

# ── Storage ────────────────────────────────────────────────────────
# MOMENTUM_DB=~/.momentum/momentum.db
# MOMENTUM_STATE_FILE=~/.momentum/state.json

# ── Observation ────────────────────────────────────────────────────
# MOMENTUM_OBSERVATION_DAYS=7

# ── Discovery tuning ───────────────────────────────────────────────
# MOMENTUM_MIN_AUTOMATION_SCORE=60
# MOMENTUM_MIN_CONFIDENCE=0.70

# ── Logging ────────────────────────────────────────────────────────
# MOMENTUM_LOG_LEVEL=INFO
